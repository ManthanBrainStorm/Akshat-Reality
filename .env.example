# Copy this file to .env and fill in real values.
# .env is already git-ignored — never commit real keys.

# Web3Forms access key for the enquiry form (free, no backend needed).
# Get one at https://web3forms.com — enter your email, they email you the key.
VITE_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 Measurement ID (starts with "G-").
# Leave empty and no analytics script loads at all.
# Get one at https://analytics.google.com — Admin -> Data Streams -> your site.
VITE_GA_MEASUREMENT_ID=
